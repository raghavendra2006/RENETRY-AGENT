# ==============================================================================
# ReTurn Platform - Environment Variables Template
# ==============================================================================

# Flask Application Secret
SECRET_KEY=re_turn_platform_secret_key_2026_secure_hash

# AI API Configuration (Google Gemini or OpenAI-compatible endpoint)
# Set your API key below. If left blank, the platform uses intelligent dynamic fallback heuristics.
AI_API_KEY=your_ai_api_key_here
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Database Configuration
DATABASE_PATH=return_platform.db

# Server Configuration
PORT=5000
FLASK_ENV=development
